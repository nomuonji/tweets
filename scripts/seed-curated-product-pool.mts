async function main() {
  const catalog = adminDb.collection("products");
  const existing = new Set((await catalog.get()).docs.map((doc) => doc.id.toUpperCase()));
  const now = DateTime.utc().toISO();
  const batch = adminDb.batch();
  const added: string[] = [];

  for (const [asin, title, price, category, theme, role, hook, score, sourceQuery] of seeds) {
    const normalized = asin.toUpperCase();
    if (existing.has(normalized)) continue;
    const ref = catalog.doc(normalized);
    batch.set(ref, {
      id: normalized,
      asin: normalized,
      title,
      url: `https://www.amazon.co.jp/dp/${normalized}?tag=tweets-sns-22`,
      image_url: `https://images-na.ssl-images-amazon.com/images/P/${normalized}.jpg`,
      price,
      category,
      theme,
      role,
      description: theme,
      promo_hook: hook,
      score,
      status: "candidate",
      source_url: `https://www.amazon.co.jp/s?k=${encodeURIComponent(sourceQuery)}`,
      notes: "Amazon検索実測を起点に、Endou系ストアの場面編集、Makuakeの生活改善、デザイン雑貨メディアの視点で選定。価格・在庫・評価は変動するため公開前に再確認。",
      created_at: now,
      updated_at: now,
    });
    added.push(normalized);
    existing.add(normalized);
  }

  await batch.commit();
  const finalCount = (await catalog.get()).size;
  console.log(JSON.stringify({ target: 100, before: finalCount - added.length, added: added.length, finalCount, asins: added }, null, 2));
}

main().catch((error) => {
  console.error(error);
  process.exitCode = 1;
});
